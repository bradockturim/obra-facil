# Copie este arquivo para .env e preencha com as credenciais do seu projeto
# Supabase. Veja SETUP.md para o passo a passo de como criar o projeto e
# onde encontrar esses valores (Project Settings > API).

VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-anon-key-publica
